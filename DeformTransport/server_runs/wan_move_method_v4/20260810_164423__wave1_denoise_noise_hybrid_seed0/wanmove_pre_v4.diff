+                        hh = (
+                            target_h0
+                            + dy
+                        )
+
+                        ww = (
+                            target_w0
+                            + dx
+                        )
+
+                        if not (
+                            0 <= source_h < H
+                            and 0 <= source_w < W
+                            and 0 <= hh < H
+                            and 0 <= ww < W
+                        ):
+                            continue
+
+                        groups.setdefault(
+                            (
+                                hh,
+                                ww,
+                            ),
+                            [],
+                        ).append(
+                            (
+                                z,
+                                material_id,
+                                source_h,
+                                source_w,
+                            )
+                        )
+
+            for (
+                hh,
+                ww,
+            ), candidates in groups.items():
+
+                (
+                    z,
+                    material_id,
+                    source_h,
+                    source_w,
+                ) = min(
+                    candidates,
+                    key=lambda item: (
+                        item[0],
+                        item[1],
+                    ),
+                )
+
+                vae_feature[
+                    0,
+                    :,
+                    tau,
+                    hh,
+                    ww,
+                ] = (
+                    vae_feature[
+                        0,
+                        :,
+                        0,
+                        source_h,
+                        source_w,
+                    ]
+                )
+
     return vae_feature
 
