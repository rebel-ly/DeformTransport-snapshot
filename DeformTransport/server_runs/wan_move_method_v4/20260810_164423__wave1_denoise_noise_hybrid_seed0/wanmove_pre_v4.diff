+                        ii
+                    ].item()
+                )
+
+                target_w0 = int(
+                    target_w[
+                        ii
+                    ].item()
+                )
+
+                z = float(
+                    depth_sampled[
+                        tau,
+                        ii,
+                    ].item()
+                )
+
+                if (
+                    not math.isfinite(
+                        z
+                    )
+                    or z <= 0
+                ):
+                    continue
+
+                material_id = int(
+                    ids[
+                        ii
+                    ].item()
+                )
+
+                for dy in (
+                    -1,
+                    0,
+                    1,
+                ):
+                    for dx in (
+                        -1,
+                        0,
+                        1,
+                    ):
+
+                        source_h = (
+                            source_h0
+                            + dy
+                        )
+
+                        source_w = (
+                            source_w0
+                            + dx
+                        )
