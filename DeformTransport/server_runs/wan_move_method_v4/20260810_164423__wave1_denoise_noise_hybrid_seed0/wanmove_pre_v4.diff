+                        ]
+                    )
+
+                else:
+
+                    source_h = int(
+                        src_h[
+                            best
+                        ].item()
+                    )
+
+                    source_w = int(
+                        src_w[
+                            best
+                        ].item()
+                    )
+
+                    feat = (
+                        vae_feature[
+                            0,
+                            :,
+                            0,
+                            source_h,
+                            source_w,
+                        ]
+                    )
+
+                vae_feature[
+                    0,
+                    :,
+                    tau,
+                    hh,
+                    ww,
+                ] = feat
+
+
+        # ====================================================
+        # V3E:
+        #
+        # depth-aware 3x3 local source-condition patch.
+        #
+        # Every target latent cell still has exactly one
+        # winning material contributor.
+        # ====================================================
+
+        else:
+
+            groups = {}
+
+            for ii in indices.tolist():
+
+                source_h0 = int(
+                    src_h[
+                        ii
+                    ].item()
+                )
+
+                source_w0 = int(
+                    src_w[
